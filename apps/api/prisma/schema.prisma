generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum NotificationType {
  DEPLOYMENT_SUCCESS
  DEPLOYMENT_FAILED
  ENVIRONMENT_CHANGE
  ROLLBACK
  SYSTEM
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String
  role          Role           @default(DEVELOPER)
  googleId      String?        @unique
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  deployments   Deployment[]   @relation("TriggeredDeployments")
  notifications Notification[]
  resetTokens   PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Project {
  id           String                @id @default(uuid())
  name         String
  description  String?
  repoUrl      String
  branch       String                @default("main")
  framework    String?
  environment  Environment           @default(DEVELOPMENT)
  tags         String[]              @default([])
  archivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  ownerId      String
  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  envVars      EnvironmentVariable[]
  deployments  Deployment[]

  @@index([ownerId])
  @@index([archivedAt])
}

model EnvironmentVariable {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key             String
  encryptedValue  String
  environment     Environment @default(DEVELOPMENT)
  version         Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  history         EnvVarHistory[]

  @@unique([projectId, key, environment])
  @@index([projectId])
}

model EnvVarHistory {
  id              String              @id @default(uuid())
  envVarId        String
  envVar          EnvironmentVariable @relation(fields: [envVarId], references: [id], onDelete: Cascade)
  key             String
  encryptedValue  String
  version         Int
  changedBy       String
  createdAt       DateTime            @default(now())

  @@index([envVarId])
}

model Deployment {
  id               String           @id @default(uuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           Int
  status           DeploymentStatus @default(PENDING)
  durationMs       Int?
  logs             String           @default("")
  failureReason    String?
  rollbackAvailable Boolean         @default(false)
  triggeredById    String
  triggeredBy      User             @relation("TriggeredDeployments", fields: [triggeredById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([projectId, number])
  @@index([projectId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
