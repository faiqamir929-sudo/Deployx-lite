# DeployX Lite — Environment Variables

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://deployx:deployx_secret@localhost:5432/deployx_lite?schema=public"

# ── Redis (BullMQ) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Google OAuth (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── GitHub Integration ────────────────────────────────────
GITHUB_TOKEN=

# ── AI Assistant ──────────────────────────────────────────
# Options: ollama | openrouter | openai
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Email (optional — Mailpit in dev) ─────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@deployx.local
EMAIL_ENABLED=false

# ── MinIO (optional log storage) ──────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=deployx
MINIO_SECRET_KEY=deployx_secret
MINIO_BUCKET=deployx-logs
