# Copy this file to .env before starting the local stack.
# Never commit .env. Generate both secrets with a local Node installation:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# ─── Local PostgreSQL ─────────────────────────────────────────────────────────
# docker compose requires POSTGRES_PASSWORD to be explicitly set. Use a
# generated hex value so it is safe to place in DATABASE_URL without encoding.
POSTGRES_USER=deployx
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_DB=deployx
POSTGRES_PORT=5432

# Used by the API when it runs directly on the host. Docker Compose builds its
# container-network URL from the POSTGRES_* values above.
DATABASE_URL=postgresql://deployx:replace-with-local-password@localhost:5432/deployx

# BullMQ/worker Redis endpoint. Host development uses the local Redis port;
# Docker Compose overrides this inside containers with redis://redis:6379.
# The application has the same localhost default for non-production commands,
# but production deployments must provide REDIS_URL explicitly.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Used to encrypt environment-variable values stored by the API.
SESSION_SECRET=replace-with-a-generated-local-secret

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Use the development/test keys for local work. The publishable key is public
# and is intentionally supplied twice: VITE_* is embedded in the frontend
# bundle, while the non-VITE key is read by the API at runtime.
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
# Leave empty for local development; Clerk proxying is for production hosting.
VITE_CLERK_PROXY_URL=

# ─── OpenAI AI integration ────────────────────────────────────────────────────
# These are the names read by @workspace/integrations-openai-ai-server.
# Do not replace them with OPENAI_API_KEY / OPENAI_BASE_URL.
AI_INTEGRATIONS_OPENAI_API_KEY=replace-with-your-OpenAI-compatible-provider-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Local processes ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
WEB_PORT=5173
API_PORT=8080
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
LOG_LEVEL=info
